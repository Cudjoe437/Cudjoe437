# Copy to .env — loaded automatically by `npm start`
ANTHROPIC_API_KEY=

# Required in production: random secret that encrypts stored WordPress credentials
APP_SECRET=
# Public base URL (used in the snippet tag and Stripe redirects), e.g. https://rankwise.example.com
PUBLIC_URL=

# Stripe (leave empty for demo mode: billing off, all features unlocked)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# PRO_PRICE_LABEL=$49/month

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# PORT=3000
# DATA_DIR=./data
# MAX_CRAWL_PAGES=8
# AI_DISABLED=1
